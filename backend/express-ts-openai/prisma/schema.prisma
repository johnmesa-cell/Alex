generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id_rol      Int       @id @default(autoincrement()) @map("idrol")
  nombre_rol  String    @unique @db.VarChar(50) @map("nombrerol")
  descripcion String?
  usuario     Usuario[]

  @@map("roles")
}

model Usuario {
  id_usuario     Int              @id @default(autoincrement()) @map("idusuario")
  id_rol         Int              @map("idrol")
  nombre         String           @db.VarChar(100)
  correo         String           @unique @db.VarChar(150)
  password_hash  String           @map("passwordhash")
  fecha_registro DateTime?        @default(now()) @db.Timestamp(6) @map("fecharegistro")
  ultimo_login   DateTime?        @db.Timestamp(6) @map("ultimologin")
  estado         String?          @default("activo") @db.VarChar(20)
  auditoria      auditoria[]
  notificaciones notificaciones[]
  registros      Registro[]
  reportes       reportes[]
  sesiones       Sesion[]
  consultas      Consulta[]
  roles          Rol              @relation(fields: [id_rol], references: [id_rol], onUpdate: NoAction, map: "fk_usuario_rol")

  @@map("usuario")
}

model Sesion {
  id_sesion        Int       @id @default(autoincrement()) @map("idsesion")
  id_usuario       Int       @map("idusuario")
  token            String
  fecha_inicio     DateTime? @default(now()) @db.Timestamp(6) @map("fechainicio")
  ultima_actividad DateTime? @db.Timestamp(6) @map("ultimaactividad")
  fecha_expiracion DateTime? @db.Timestamp(6) @map("fechaexpiracion")
  ip               String?   @db.VarChar(45)
  user_agent       String?   @map("useragent")
  usuario          Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_sesion_usuario")

  @@map("sesiones")
}

model Registro {
  id_registro         Int       @id @default(autoincrement())
  id_creador          Int
  titulo              String    @db.VarChar(200)
  descripcion         String?
  categoria           String?   @db.VarChar(100)
  activo              Boolean?  @default(true)
  fecha_creacion      DateTime? @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime? @db.Timestamp(6)
  fecha_eliminacion   DateTime? @db.Timestamp(6)
  usuario             Usuario   @relation(fields: [id_creador], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_registro_usuario")

  @@map("registros")
}

model auditoria {
  id_evento            Int       @id @default(autoincrement())
  id_usuario           Int?
  accion               String    @db.VarChar(50)
  tabla_afectada       String?   @db.VarChar(100)
  id_registro_afectado Int?
  valor_anterior       String?
  valor_nuevo          String?
  timestamp            DateTime? @default(now()) @db.Timestamp(6)
  ip                   String?   @db.VarChar(45)
  usuario              Usuario?  @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction, map: "fk_auditoria_usuario")
}

model notificaciones {
  id_notificacion Int       @id @default(autoincrement())
  id_usuario      Int
  mensaje         String
  tipo            String?   @db.VarChar(50)
  leida           Boolean?  @default(false)
  fecha_envio     DateTime? @default(now()) @db.Timestamp(6)
  usuario         Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_notificacion_usuario")
}

model reportes {
  id_reporte           Int                    @id @default(autoincrement())
  id_usuario           Int
  nombre               String?                @db.VarChar(150)
  descripcion          String?
  configuracion        String?
  fecha_creacion       DateTime?              @default(now()) @db.Timestamp(6)
  usuario              Usuario                @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_reporte_usuario")
  reportes_programados reportes_programados[]
}

model reportes_programados {
  id_programacion         Int       @id @default(autoincrement())
  id_reporte              Int
  frecuencia              String?   @db.VarChar(50)
  fecha_proxima_ejecucion DateTime? @db.Timestamp(6)
  activo                  Boolean?  @default(true)
  reportes                reportes  @relation(fields: [id_reporte], references: [id_reporte], onDelete: Cascade, onUpdate: NoAction, map: "fk_programacion_reporte")
}


model Consulta {
  id_consulta    Int       @id @default(autoincrement()) @map("idconsulta")
  id_usuario     Int       @map("idusuario")
  asunto         String    @db.VarChar(200)
  mensaje        String    @db.Text
  respuesta_ia   String?   @db.Text @map("respuestaia")
  fecha_creacion DateTime? @default(now()) @db.Timestamp(6) @map("fechacreacion")
  estado         String?   @default("abierta") @db.VarChar(20)
  usuario        Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_consulta_usuario")

  @@map("consultas")
}
